{
  "manifest_version": 3,
  "name": "ScrollFix – Force Horizontal Scrollbars",
  "version": "1.0.0",
  "description": "Adds a horizontal scrollbar to elements that overflow but have scrolling blocked by the site.",
  "icons": {
    "16": "icons/scrollfix-16.png",
    "32": "icons/scrollfix-32.png",
    "48": "icons/scrollfix-48.png",
    "128": "icons/scrollfix-128.png"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_icon": {
      "16": "icons/scrollfix-16.png",
      "32": "icons/scrollfix-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "ScrollFix"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
